# Any OpenAI-compatible endpoint works (Groq, Gemini OpenAI-compat, OpenAI, OpenRouter...)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# default = chroma's built-in MiniLM (downloads a small model on first run)
# hash    = tiny offline embedding, only for tests
EMBEDDINGS=default

TOP_K=4
MIN_RETRIEVAL_SCORE=0.30
CONFIDENCE_THRESHOLD=0.70

# Slack (Phase 7, optional)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
